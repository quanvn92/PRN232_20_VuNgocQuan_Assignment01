@model List<_20_VuNgocQuan_Assignment01_FrontEnd.DTOs.NewsArticleDto>
@{ ViewData["Title"] = "My News History"; }

<div class="row mt-4">
    <div class="col-md-3">
        <div class="list-group">
            <a asp-action="Index" class="list-group-item list-group-item-action"><i class="bi bi-house"></i> Dashboard</a>
            <a asp-action="Categories" class="list-group-item list-group-item-action"><i class="bi bi-folder2-open"></i> Categories</a>
            <a asp-action="NewsArticles" class="list-group-item list-group-item-action"><i class="bi bi-newspaper"></i> News Articles</a>
            <a asp-action="NewsHistory" class="list-group-item list-group-item-action active"><i class="bi bi-clock-history"></i> My News History</a>
            <a asp-action="Profile" class="list-group-item list-group-item-action"><i class="bi bi-person-gear"></i> My Profile</a>
        </div>
    </div>
    <div class="col-md-9">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-clock-history"></i> My News History <span class="badge bg-primary">@Model.Count</span></h5>
            </div>
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-inbox fs-2"></i>
                        <p class="mt-2">You haven't created any news articles yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-dark">
                                <tr><th>ID</th><th>Title</th><th>Category</th><th>Created</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var a in Model.OrderByDescending(x => x.CreatedDate))
                                {
                                    <tr>
                                        <td><code>@a.NewsArticleID</code></td>
                                        <td>@a.NewsTitle</td>
                                        <td>@a.CategoryName</td>
                                        <td>@a.CreatedDate?.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            @if (a.NewsStatus == true)
                                            { <span class="badge bg-success">Active</span> }
                                            else
                                            { <span class="badge bg-secondary">Inactive</span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
