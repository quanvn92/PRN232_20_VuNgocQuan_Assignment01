@model _20_VuNgocQuan_Assignment01_FrontEnd.DTOs.UpdateCategoryDto
@{ var parents = ViewBag.ParentCategories as List<_20_VuNgocQuan_Assignment01_FrontEnd.DTOs.CategoryDto> ?? new(); }
<form id="catEditForm" asp-action="CategoryEdit" asp-controller="Staff" asp-route-id="@ViewBag.CategoryID" method="post">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-12">
            <label asp-for="CategoryName" class="form-label">Category Name</label>
            <input asp-for="CategoryName" class="form-control" />
            <span asp-validation-for="CategoryName" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="CategoryDesciption" class="form-label">Description</label>
            <textarea asp-for="CategoryDesciption" class="form-control" rows="3"></textarea>
        </div>
        <div class="col-md-6">
            <label asp-for="ParentCategoryID" class="form-label">Parent Category</label>
            <select asp-for="ParentCategoryID" class="form-select">
                <option value="">— None —</option>
                @foreach (var p in parents)
                {
                    <option value="@p.CategoryID" selected="@(Model.ParentCategoryID == p.CategoryID)">@p.CategoryName</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="IsActive" class="form-label">Status</label>
            <select asp-for="IsActive" class="form-select">
                <option value="true" selected="@(Model.IsActive == true)">Active</option>
                <option value="false" selected="@(Model.IsActive == false)">Inactive</option>
            </select>
        </div>
    </div>
    <div class="d-flex justify-content-end gap-2 mt-4">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-warning" onclick="submitModalForm('catEditForm')">
            <i class="bi bi-save"></i> Save Changes
        </button>
    </div>
</form>
