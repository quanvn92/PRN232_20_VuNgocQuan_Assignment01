@model _20_VuNgocQuan_Assignment01_FrontEnd.DTOs.UpdateNewsArticleDto
@{
    var categories = ViewBag.Categories as List<_20_VuNgocQuan_Assignment01_FrontEnd.DTOs.CategoryDto> ?? new();
    var tags = ViewBag.Tags as List<_20_VuNgocQuan_Assignment01_FrontEnd.DTOs.TagDto> ?? new();
    var selectedTags = Model.TagIds ?? new List<int>();
}
<form id="newsEditForm" asp-action="NewsArticleEdit" asp-controller="Staff" asp-route-id="@ViewBag.ArticleID" method="post">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Article ID</label>
            <input type="text" class="form-control" value="@ViewBag.ArticleID" readonly />
        </div>
        <div class="col-md-6">
            <label asp-for="CategoryID" class="form-label">Category</label>
            <select asp-for="CategoryID" class="form-select">
                <option value="">— Select Category —</option>
                @foreach (var c in categories)
                {
                    <option value="@c.CategoryID" selected="@(Model.CategoryID == c.CategoryID)">@c.CategoryName</option>
                }
            </select>
        </div>
        <div class="col-12">
            <label asp-for="NewsTitle" class="form-label">Title</label>
            <input asp-for="NewsTitle" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="Headline" class="form-label">Headline <span class="text-danger">*</span></label>
            <input asp-for="Headline" class="form-control" maxlength="150" />
            <span asp-validation-for="Headline" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="NewsContent" class="form-label">Content</label>
            <textarea asp-for="NewsContent" class="form-control" rows="5"></textarea>
        </div>
        <div class="col-md-6">
            <label asp-for="NewsSource" class="form-label">Source</label>
            <input asp-for="NewsSource" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="NewsStatus" class="form-label">Status</label>
            <select asp-for="NewsStatus" class="form-select">
                <option value="true" selected="@(Model.NewsStatus == true)">Active</option>
                <option value="false" selected="@(Model.NewsStatus == false)">Inactive</option>
            </select>
        </div>
        <div class="col-12">
            <label class="form-label">Tags</label>
            <div class="d-flex flex-wrap gap-2 p-2 border rounded">
                @foreach (var t in tags)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="TagIds" value="@t.TagID"
                               id="tag-e-@t.TagID" checked="@(selectedTags.Contains(t.TagID))" />
                        <label class="form-check-label badge bg-secondary rounded-pill" for="tag-e-@t.TagID">
                            @t.TagName
                        </label>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-end gap-2 mt-4">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-warning" onclick="submitModalForm('newsEditForm')">
            <i class="bi bi-save"></i> Save Changes
        </button>
    </div>
</form>
