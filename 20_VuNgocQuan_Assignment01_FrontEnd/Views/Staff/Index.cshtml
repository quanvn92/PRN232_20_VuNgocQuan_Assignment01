@{ ViewData["Title"] = "Staff Dashboard"; }
<div class="row mt-4">
    <div class="col-md-3">
        <div class="list-group">
            <a asp-action="Categories" class="list-group-item list-group-item-action"><i class="bi bi-folder2-open"></i> Categories</a>
            <a asp-action="NewsArticles" class="list-group-item list-group-item-action"><i class="bi bi-newspaper"></i> News Articles</a>
            <a asp-action="NewsHistory" class="list-group-item list-group-item-action"><i class="bi bi-clock-history"></i> My News History</a>
            <a asp-action="Profile" class="list-group-item list-group-item-action"><i class="bi bi-person-gear"></i> My Profile</a>
        </div>
    </div>
    <div class="col-md-9">
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-person-badge display-1 text-success"></i>
                <h3 class="mt-3">Welcome, @Context.Session.GetString("AccountName")</h3>
                <p class="text-muted">Use the menu on the left to manage categories and news articles.</p>
            </div>
        </div>
    </div>
</div>
