@model List<_20_VuNgocQuan_Assignment01_FrontEnd.DTOs.CategoryDto>
@{ ViewData["Title"] = "Category Management"; }

<div class="row mt-4">
    <div class="col-md-3">
        <div class="list-group">
            <a asp-action="Index" class="list-group-item list-group-item-action"><i class="bi bi-house"></i> Dashboard</a>
            <a asp-action="Categories" class="list-group-item list-group-item-action active"><i class="bi bi-folder2-open"></i> Categories</a>
            <a asp-action="NewsArticles" class="list-group-item list-group-item-action"><i class="bi bi-newspaper"></i> News Articles</a>
            <a asp-action="NewsHistory" class="list-group-item list-group-item-action"><i class="bi bi-clock-history"></i> My News History</a>
            <a asp-action="Profile" class="list-group-item list-group-item-action"><i class="bi bi-person-gear"></i> My Profile</a>
        </div>
    </div>
    <div class="col-md-9">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-folder2-open"></i> Category Management</h5>
                <button class="btn btn-success btn-sm"
                        onclick="openModal('Create Category', '@Url.Action("CategoryCreate")')">
                    <i class="bi bi-plus-lg"></i> Add Category
                </button>
            </div>
            <div class="card-body">
                <form method="get" class="d-flex gap-2 mb-3">
                    <input type="text" name="keyword" value="@ViewBag.Keyword"
                           class="form-control form-control-sm" placeholder="Search categories..." />
                    <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-search"></i></button>
                    @if (!string.IsNullOrEmpty(ViewBag.Keyword as string))
                    {
                        <a asp-action="Categories" class="btn btn-outline-danger btn-sm"><i class="bi bi-x"></i></a>
                    }
                </form>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr><th>ID</th><th>Name</th><th>Description</th><th>Parent</th><th>Status</th><th class="text-end">Actions</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                <tr id="row-cat-@c.CategoryID">
                                    <td><span class="badge bg-secondary">@c.CategoryID</span></td>
                                    <td class="fw-semibold">@c.CategoryName</td>
                                    <td class="text-muted small">@(c.CategoryDesciption.Length > 60 ? c.CategoryDesciption[..60] + "…" : c.CategoryDesciption)</td>
                                    <td>@(c.ParentCategoryName ?? "—")</td>
                                    <td>
                                        @if (c.IsActive == true)
                                        { <span class="badge bg-success">Active</span> }
                                        else
                                        { <span class="badge bg-secondary">Inactive</span> }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-warning"
                                                onclick="openModal('Edit Category', '@Url.Action("CategoryEdit", new { id = c.CategoryID })')">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger ms-1"
                                                onclick="confirmDelete('Delete category @c.CategoryName?', () => deleteCategory(@c.CategoryID))">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr><td colspan="6" class="text-center text-muted py-4">No categories found.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function deleteCategory(id) {
    fetch('@Url.Action("CategoryDelete")', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'id=' + id
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) document.getElementById('row-cat-' + id)?.remove();
        else alert('Error: ' + (data.error || 'Cannot delete this category.'));
    });
}
</script>
}
