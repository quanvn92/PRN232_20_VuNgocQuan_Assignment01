@model _20_VuNgocQuan_Assignment01_FrontEnd.DTOs.NewsArticleDto
@{ ViewData["Title"] = Model.NewsTitle; }

<div class="container py-4" style="max-width: 860px;">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="bi bi-arrow-left"></i> Back to News
    </a>
    <article class="card shadow-sm">
        <div class="card-body p-4 p-md-5">
            @if (!string.IsNullOrEmpty(Model.CategoryName))
            {
                <span class="badge bg-primary rounded-pill mb-2">@Model.CategoryName</span>
            }
            <h1 class="card-title h2">@Model.NewsTitle</h1>
            <p class="text-primary fw-semibold fst-italic">@Model.Headline</p>
            <div class="d-flex flex-wrap gap-3 text-muted small mb-3 border-bottom pb-3">
                <span><i class="bi bi-person"></i> @Model.CreatedByName</span>
                <span><i class="bi bi-calendar3"></i> @Model.CreatedDate?.ToString("MMMM dd, yyyy")</span>
                @if (!string.IsNullOrEmpty(Model.NewsSource))
                {
                    <span><i class="bi bi-link-45deg"></i> @Model.NewsSource</span>
                }
            </div>
            <div class="mt-3" style="white-space: pre-wrap; line-height: 1.8;">@Model.NewsContent</div>
            @if (Model.Tags.Any())
            {
                <div class="mt-4 pt-3 border-top">
                    <strong class="small text-muted">TAGS:</strong>
                    @foreach (var tag in Model.Tags)
                    {
                        <span class="badge bg-secondary rounded-pill ms-1">@tag.TagName</span>
                    }
                </div>
            }
        </div>
    </article>
</div>
