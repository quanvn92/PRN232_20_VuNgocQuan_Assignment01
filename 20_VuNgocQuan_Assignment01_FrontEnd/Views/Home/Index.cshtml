@model List<_20_VuNgocQuan_Assignment01_FrontEnd.DTOs.NewsArticleDto>
@{ ViewData["Title"] = "FU News - Latest Articles"; }

<div class="py-4">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="display-5 fw-bold"><i class="bi bi-newspaper text-primary"></i> Latest News</h1>
            <p class="text-muted">Stay updated with the latest news from FPT University</p>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mt-2">No news articles available at the moment.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var article in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <div class="mb-2">
                                    @if (!string.IsNullOrEmpty(article.CategoryName))
                                    {
                                        <span class="badge bg-primary rounded-pill">@article.CategoryName</span>
                                    }
                                </div>
                                <h5 class="card-title">@article.NewsTitle</h5>
                                <p class="card-text text-muted small flex-grow-1">
                                    @(article.Headline.Length > 120 ? article.Headline[..120] + "..." : article.Headline)
                                </p>
                                <div class="mt-auto">
                                    <div class="d-flex flex-wrap gap-1 mb-2">
                                        @foreach (var tag in article.Tags)
                                        {
                                            <span class="badge bg-secondary rounded-pill small">@tag.TagName</span>
                                        }
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">
                                            <i class="bi bi-calendar3"></i>
                                            @article.CreatedDate?.ToString("MMM dd, yyyy")
                                        </small>
                                        <a asp-action="Detail" asp-route-id="@article.NewsArticleID"
                                           class="btn btn-sm btn-outline-primary">
                                            Read More <i class="bi bi-arrow-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
