@model _20_VuNgocQuan_Assignment01_FrontEnd.DTOs.UpdateSystemAccountDto
<form id="accountEditForm" asp-action="AccountEdit" asp-controller="Admin" asp-route-id="@ViewBag.AccountID" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>
    <div class="row g-3">
        <div class="col-12">
            <label asp-for="AccountName" class="form-label">Full Name</label>
            <input asp-for="AccountName" class="form-control" />
            <span asp-validation-for="AccountName" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="AccountEmail" class="form-label">Email</label>
            <input asp-for="AccountEmail" type="email" class="form-control" />
            <span asp-validation-for="AccountEmail" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="AccountRole" class="form-label">Role</label>
            <select asp-for="AccountRole" class="form-select">
                <option value="1">Staff</option>
                <option value="2">Lecturer</option>
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="AccountPassword" class="form-label">New Password <small class="text-muted">(leave blank to keep)</small></label>
            <input asp-for="AccountPassword" type="password" class="form-control" placeholder="••••••••" />
        </div>
    </div>
    <div class="d-flex justify-content-end gap-2 mt-4">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-warning" onclick="submitModalForm('accountEditForm')">
            <i class="bi bi-save"></i> Save Changes
        </button>
    </div>
</form>
