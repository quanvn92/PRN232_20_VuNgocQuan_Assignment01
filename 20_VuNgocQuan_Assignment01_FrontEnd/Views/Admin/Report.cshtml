@model List<_20_VuNgocQuan_Assignment01_FrontEnd.DTOs.NewsArticleDto>
@{ ViewData["Title"] = "Statistics Report"; }

<div class="row mt-4">
    <div class="col-md-3">
        <div class="list-group">
            <a asp-action="Index" class="list-group-item list-group-item-action"><i class="bi bi-house"></i> Dashboard</a>
            <a asp-action="Accounts" class="list-group-item list-group-item-action"><i class="bi bi-people-fill"></i> Account Management</a>
            <a asp-action="Report" class="list-group-item list-group-item-action active"><i class="bi bi-bar-chart-fill"></i> Statistics Report</a>
        </div>
    </div>
    <div class="col-md-9">
        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0"><i class="bi bi-filter"></i> Filter by Date Range</h5></div>
            <div class="card-body">
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label fw-semibold">Start Date</label>
                            <input type="date" name="startDate" class="form-control"
                                   value="@(ViewBag.StartDate != null ? ((DateTime)ViewBag.StartDate).ToString("yyyy-MM-dd") : "")" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-semibold">End Date</label>
                            <input type="date" name="endDate" class="form-control"
                                   value="@(ViewBag.EndDate != null ? ((DateTime)ViewBag.EndDate).ToString("yyyy-MM-dd") : "")" />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-search"></i> Search
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @if (Model != null)
        {
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Results <span class="badge bg-primary">@Model.Count</span></h5>
                    @if (ViewBag.StartDate != null)
                    {
                        <small class="text-muted">
                            @((DateTime)ViewBag.StartDate).ToString("MMM dd, yyyy") –
                            @((DateTime)ViewBag.EndDate).ToString("MMM dd, yyyy")
                        </small>
                    }
                </div>
                <div class="card-body p-0">
                    @if (!Model.Any())
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-2"></i><p>No articles found in this date range.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th><th>Title</th><th>Category</th>
                                        <th>Created By</th><th>Created Date</th><th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in Model.OrderByDescending(x => x.CreatedDate))
                                    {
                                        <tr>
                                            <td><code>@a.NewsArticleID</code></td>
                                            <td>@a.NewsTitle</td>
                                            <td>@a.CategoryName</td>
                                            <td>@a.CreatedByName</td>
                                            <td>@a.CreatedDate?.ToString("yyyy-MM-dd")</td>
                                            <td>
                                                @if (a.NewsStatus == true)
                                                { <span class="badge bg-success">Active</span> }
                                                else
                                                { <span class="badge bg-secondary">Inactive</span> }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
