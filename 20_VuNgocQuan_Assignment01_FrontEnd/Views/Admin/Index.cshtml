@{ ViewData["Title"] = "Admin Dashboard"; }

<div class="row mt-4">
    <div class="col-md-3">
        <div class="list-group">
            <a asp-action="Accounts" class="list-group-item list-group-item-action">
                <i class="bi bi-people-fill"></i> Account Management
            </a>
            <a asp-action="Report" class="list-group-item list-group-item-action">
                <i class="bi bi-bar-chart-fill"></i> Statistics Report
            </a>
        </div>
    </div>
    <div class="col-md-9">
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-speedometer2 display-1 text-primary"></i>
                <h3 class="mt-3">Welcome, Administrator</h3>
                <p class="text-muted">Use the menu on the left to manage accounts and view reports.</p>
            </div>
        </div>
    </div>
</div>
